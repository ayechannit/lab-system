# Backend origin. In Vite DEV the admin UI always uses same-origin `/api` via
# the Vite proxy; this value is the proxy target (and is required for production builds).
VITE_API_BASE_URL=http://localhost:3000

# AI conversation — UUIDs from your database (ai_configs / prompts tables)
VITE_AI_CONFIG_ID=
VITE_LAB_RESULT_VALIDATION_PROMPT_ID=
VITE_LAB_RESULT_SUMMARIZED_PROMPT_ID=

# Collection route planning (optional; route config falls back to VITE_AI_CONFIG_ID)
VITE_COLLECTION_ROUTE_AI_CONFIG_ID=
VITE_COLLECTION_ROUTE_PROMPT_ID=
