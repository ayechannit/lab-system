# Optional public API URL (on Vercel, VERCEL_URL is used automatically if unset)
HOST_URL=

# Database Configuration
DB_SERVER=localhost
DB_USER=sa
DB_PASSWORD=YourStrongPassword!
DB_DATABASE=lab_system
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Firebase Configuration
# Path to your downloaded Firebase Admin SDK Service Account JSON private key (needed for sending push notifications)
# e.g., FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=

# AWS S3 (required for advertisement banners and production file storage)
# Set these on Vercel too — without them banner images cannot be resolved.
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
# Optional: CloudFront or custom public CDN base (defaults to https://{bucket}.s3.{region}.amazonaws.com)
AWS_S3_PUBLIC_BASE_URL=
# Presigned URL lifetime in seconds for private S3 objects (max 604800 = 7 days)
AWS_S3_PRESIGN_EXPIRES_SECONDS=604800
# Set to true to upload all files to S3 in local dev (not only advertisements)
USE_S3_STORAGE=false
