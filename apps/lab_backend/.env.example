# Optional public API URL (on Vercel, VERCEL_URL is used automatically if unset)
HOST_URL=

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=YourStrongPassword!
DB_DATABASE=lab_system
# Set to true for managed providers that require TLS (Azure/AWS/Supabase/Neon, etc.)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# One-time data migration only (scripts/migrateDataToPostgres.js and
# scripts/introspectMssqlSchema.js) — the old MSSQL source database, kept under
# separate SOURCE_DB_*/TARGET_DB_* names so this doesn't collide with the DB_*
# vars above once they point at PostgreSQL. See scripts/migrateDataToPostgres.js
# for full instructions. Safe to delete once the migration is complete.
# SOURCE_DB_SERVER=
# SOURCE_DB_DATABASE=
# SOURCE_DB_USER=
# SOURCE_DB_PASSWORD=
# SOURCE_DB_ENCRYPT=false
# SOURCE_DB_TRUST_SERVER_CERTIFICATE=true
# TARGET_DB_HOST=
# TARGET_DB_PORT=5432
# TARGET_DB_DATABASE=
# TARGET_DB_USER=
# TARGET_DB_PASSWORD=
# TARGET_DB_SSL=false

# Firebase Configuration
# Path to your downloaded Firebase Admin SDK Service Account JSON private key (needed for sending push notifications)
# e.g., FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=

# AWS S3 (required for advertisement banners and production file storage)
# Set these on Vercel too — without them banner images cannot be resolved.
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
# Optional: CloudFront or custom public CDN base (defaults to https://{bucket}.s3.{region}.amazonaws.com)
AWS_S3_PUBLIC_BASE_URL=
# Presigned URL lifetime in seconds for private S3 objects (max 604800 = 7 days)
AWS_S3_PRESIGN_EXPIRES_SECONDS=604800
# Set to true to upload all files to S3 in local dev (not only advertisements)
USE_S3_STORAGE=false
